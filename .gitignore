#        '-vf','crop=1024:410:0:0','-q:v','2','assets/clean/hero.jpg'])
#      subprocess.run(['ffmpeg','-y','-i','hero-homepage-background.jpg','-vf',
#        'scale=1800:-2:flags=lanczos,gblur=sigma=26,eq=saturation=0.78:brightness=-0.05',
#        '-q:v','5','assets/clean/voices-bg.jpg'])
#      PY
#   3. remove the three lines below
hero-homepage-background.jpg
assets/clean/hero.jpg
assets/clean/voices-bg.jpg

